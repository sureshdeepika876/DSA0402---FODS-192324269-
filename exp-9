import pandas as pd

# Create DataFrame
property_data = pd.DataFrame({
    "Property_ID": [101, 102, 103, 104, 105],
    "Location": ["Chennai", "Chennai", "Coimbatore", "Madurai", "Coimbatore"],
    "Bedrooms": [3, 5, 4, 6, 2],
    "Area": [1500, 2500, 1800, 3000, 1600],
    "Listing_Price": [5000000, 8000000, 6000000, 9000000, 5500000]
})

# 1. Average listing price by location
print("Average Listing Price:")
print(property_data.groupby("Location")["Listing_Price"].mean())

# 2. Properties with more than 4 bedrooms
count = property_data[property_data["Bedrooms"] > 4].shape[0]
print("\nProperties with more than 4 bedrooms:", count)

# 3. Property with largest area
largest = property_data.loc[property_data["Area"].idxmax()]
print("\nProperty with Largest Area:")
print(largest)
