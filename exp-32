import pandas as pd
from sklearn.linear_model import LinearRegression

# House dataset
data = pd.DataFrame({
    "Area": [1000, 1200, 1500, 1800, 2000, 2200, 2500, 2800],
    "Bedrooms": [2, 2, 3, 3, 4, 4, 5, 5],
    "Price": [200000, 240000, 300000, 360000,
              400000, 440000, 500000, 560000]
})

# Features and target
X = data[["Area", "Bedrooms"]]
y = data["Price"]

# Create and train model
model = LinearRegression()
model.fit(X, y)

# User input
area = float(input("Enter house area (sq.ft): "))
bedrooms = int(input("Enter number of bedrooms: "))

# Predict price
new_house = [[area, bedrooms]]
prediction = model.predict(new_house)

print("Predicted House Price:", round(prediction[0], 2))
