import numpy as np
from scipy import stats

# Blood pressure reduction (mmHg)
drug = np.array([12, 15, 10, 14, 11, 13, 16, 12, 14, 15,
                 10, 13, 11, 12, 14, 15, 13, 12, 16, 14,
                 11, 13, 15, 12, 14])

placebo = np.array([5, 7, 4, 6, 5, 8, 6, 4, 7, 5,
                    6, 5, 4, 7, 6, 5, 8, 6, 4, 5,
                    7, 6, 5, 4, 6])

# 95% Confidence Interval
drug_ci = stats.t.interval(
    0.95, len(drug)-1,
    loc=np.mean(drug),
    scale=stats.sem(drug)
)

placebo_ci = stats.t.interval(
    0.95, len(placebo)-1,
    loc=np.mean(placebo),
    scale=stats.sem(placebo)
)

print("Drug Group Mean:", round(np.mean(drug), 2))
print("Drug Group 95% CI:", tuple(round(x, 2) for x in drug_ci))

print("\nPlacebo Group Mean:", round(np.mean(placebo), 2))
print("Placebo Group 95% CI:", tuple(round(x, 2) for x in placebo_ci))
