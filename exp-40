import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

# Create e-commerce customer dataset
data = {
    'Customer_ID': [101, 102, 103, 104, 105, 106, 107, 108,
                    109, 110, 111, 112, 113, 114, 115],

    'Total_Amount_Spent': [1200, 1500, 1800, 7000, 8500,
                           9000, 1000, 1300, 7500, 8200,
                           2000, 2500, 6800, 9500, 1600],

    'Items_Purchased': [5, 7, 8, 20, 25, 28, 4, 6,
                        22, 24, 9, 11, 19, 30, 7]
}

df = pd.DataFrame(data)

# Select features
X = df[['Total_Amount_Spent', 'Items_Purchased']]

# Standardize the features
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Create K-Means model
model = KMeans(n_clusters=3, random_state=42, n_init=10)

# Train the model
model.fit(X_scaled)

# Assign clusters
df['Customer_Segment'] = model.labels_

# Display customer segmentation
print("\n--- Customer Segmentation ---")
print(df)

# Get cluster centers
centers = model.cluster_centers_

# Convert cluster centers back to original scale
centers_original = scaler.inverse_transform(centers)

# Visualize clusters
plt.figure(figsize=(8, 5))

plt.scatter(
    df['Total_Amount_Spent'],
    df['Items_Purchased'],
    c=df['Customer_Segment'],
    s=100
)

plt.scatter(
    centers_original[:, 0],
    centers_original[:, 1],
    marker='X',
    s=200
)

plt.xlabel("Total Amount Spent")
plt.ylabel("Number of Items Purchased")
plt.title("Customer Segmentation using K-Means")
plt.show()

# Get new customer details
print("\nEnter details of a new customer:")

amount = float(input("Total amount spent: "))
items = int(input("Number of items purchased: "))

# Create new customer DataFrame
new_customer = pd.DataFrame(
    [[amount, items]],
    columns=['Total_Amount_Spent', 'Items_Purchased']
)

# Standardize new customer data
new_customer_scaled = scaler.transform(new_customer)

# Predict customer segment
segment = model.predict(new_customer_scaled)

print("\n--- New Customer Prediction ---")
print("Customer is assigned to Segment:", segment[0] + 1)
