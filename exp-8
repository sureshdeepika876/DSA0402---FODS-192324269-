import pandas as pd

# Create DataFrame
sales_data = pd.DataFrame({
    "Product": ["Laptop", "Mouse", "Laptop", "Keyboard", "Mouse",
                "Monitor", "Laptop", "Keyboard", "Mouse", "Printer"],
    "Quantity": [5, 10, 3, 4, 6, 2, 7, 5, 8, 3]
})

# Top 5 most sold products
top_products = sales_data.groupby("Product")["Quantity"].sum().sort_values(ascending=False).head(5)

print("Top 5 Most Sold Products:")
print(top_products)
